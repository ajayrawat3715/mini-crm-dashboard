# Database Connection String
# Default: Local SQLite (zero-config, works out of the box)
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase, change prisma/schema.prisma datasource provider to "postgresql"
# and provide your connection string:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
