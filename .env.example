# ========================================================
# Mini CRM Dashboard - Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. OPTION A: SUPABASE CLUSTER INTEGRATION (Recommended)
# --------------------------------------------------------
# Obtain from your Supabase Project Settings -> API:
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Optional: Service role key for admin server operations (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --------------------------------------------------------
# 2. OPTION B: PRISMA ORM / POSTGRESQL / SQLITE
# --------------------------------------------------------
# Default: Local SQLite (runs with zero configuration out-of-the-box)
DATABASE_URL="file:./dev.db"

# Or if connecting Prisma directly to Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
